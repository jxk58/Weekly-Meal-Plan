# Copy to .env.local and fill in real values. Never commit .env.local.

# Runtime connection used by the app. On Supabase, use the pooled
# (transaction mode, port 6543) connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meal_planner

# Optional: direct (non-pooled, port 5432) connection used by drizzle-kit migrations.
# Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=

# IANA time zone that decides what "today" is (e.g. America/Los_Angeles). Defaults to UTC.
APP_TIME_ZONE=UTC
