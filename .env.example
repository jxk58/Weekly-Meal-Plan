# Copy to .env and fill in real values. Never commit .env.

# local | test | production
ENVIRONMENT=local
DEBUG=true

# Runtime connection used by the app. On Supabase, use the pooled
# (transaction mode, port 6543) connection string.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/meal_planner

# Optional: direct (non-pooled, port 5432) connection used by Alembic migrations.
# Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=
